#!/usr/bin/env bash
# AGY Epistemic Launcher
# Activates SciMind 5.0 Epistemic Humility, Empirical Verification, and Operational Robustness.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

export AGY_EPISTEMIC="${AGY_EPISTEMIC:-1}"

# Ensure epistemic rule is generated if active
if [ "${AGY_EPISTEMIC}" = "1" ]; then
    python3 -c "import sys; sys.path.insert(0, '${REPO_DIR}'); from agy_modules.epistemic import install_epistemic_rule; install_epistemic_rule('${REPO_DIR}/.agents/rules')" >/dev/null 2>&1 || true
fi

# Dry-run / Probe handler for test suites
if [ "${1:-}" = "--dry-run" ] || [ "${1:-}" = "--probe" ]; then
    echo "AGY-EPISTEMIC: active=1 env=AGY_EPISTEMIC=${AGY_EPISTEMIC}"
    exit 0
fi

BASE_AGY="${BASE_AGY:-/home/julian/.local/bin/agy}"
if [ ! -x "${BASE_AGY}" ]; then
    BASE_AGY="$(command -v agy || true)"
fi

if [ -z "${BASE_AGY}" ] || [ ! -x "${BASE_AGY}" ]; then
    echo "Error: Base agy executable not found." >&2
    exit 1
fi

exec "${BASE_AGY}" "$@"
