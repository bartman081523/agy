#!/usr/bin/env bash
# AGY SymComp Launcher
# Activates Converged Construct Compaction and Token Saving.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

export AGY_SYMCOMP="${AGY_SYMCOMP:-1}"

# Ensure symcomp rule is generated if active
if [ "${AGY_SYMCOMP}" = "1" ]; then
    python3 -c "import sys; sys.path.insert(0, '${REPO_DIR}'); from agy_modules.symcomp import install_symcomp_rule; install_symcomp_rule('${REPO_DIR}/.agents/rules')" >/dev/null 2>&1 || true
fi

# Dry-run / Probe handler for test suites
if [ "${1:-}" = "--dry-run" ] || [ "${1:-}" = "--probe" ]; then
    echo "AGY-SYMCOMP: active=1 env=AGY_SYMCOMP=${AGY_SYMCOMP}"
    exit 0
fi

BASE_AGY="${BASE_AGY:-/home/julian/.local/bin/agy}"
if [ ! -x "${BASE_AGY}" ]; then
    BASE_AGY="$(command -v agy || true)"
fi

if [ -z "${BASE_AGY}" ] || [ ! -x "${BASE_AGY}" ]; then
    echo "Error: Base agy executable not found." >&2
    exit 1
fi

exec "${BASE_AGY}" "$@"
